# Copy to `.dev.vars` (gitignored) for local `wrangler dev`, or set real secrets with:
#   wrangler secret put TURSO_DATABASE_URL
#   wrangler secret put TURSO_AUTH_TOKEN
#   wrangler secret put APP_SECRET

# Turso / libSQL database. Required in production.
# Get these from: `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Used to pseudonymise IPs for the view counter (HMAC). Generate with:
#   node -e "console.log(crypto.randomUUID())"
APP_SECRET="change-me-to-a-long-random-string"

# --- Paste thumbnails (all optional) ---------------------------------------
# MantisBin never stores image bytes: one image is forwarded to a public image
# host and only the returned URL is saved. A thumbnail is PUBLIC — it stays
# visible on a password-protected or burn-after-reading paste — so the editor
# warns authors not to put anything private in one. Authors can also paste ANY
# https image URL by hand (any host).
#
# Upload hosts, tried in order (comma or space separated). Default:
#   catbox,nullpointer
#     catbox      — catbox.moe. Keeps files indefinitely.
#     nullpointer — 0x0.st. Anonymous, no key, no setup; keeps files for 30 days
#                   to a year. This is the fallback that keeps uploading working
#                   when catbox refuses the Worker's datacenter IP (catbox then
#                   answers "Invalid Uploader").
# Narrow it to a single host with e.g. THUMBNAIL_PROVIDERS="catbox"; unknown
# ids are ignored.
# THUMBNAIL_PROVIDERS="catbox,nullpointer"
#
# catbox.moe — add a userhash so uploads are accepted from the Worker's
# datacenter IPs (catbox filters anonymous datacenter traffic) and are deletable
# from your catbox account. Get it from your catbox.moe account settings.
#   wrangler secret put CATBOX_USERHASH
# CATBOX_USERHASH="your-catbox-userhash"
#
# Set to "off" to disable uploading entirely (the URL field is still offered).
# THUMBNAIL_UPLOADS="off"

# --- GIF search (optional) ---------------------------------------------------
# Nekos.best needs no key. Giphy runs on its published public beta key, which is
# a shared, revocable quota: set your own key to raise the limit.
#   wrangler secret put GIPHY_API_KEY
# The key is used server-side only — it never reaches a browser.
# GIPHY_API_KEY="your-giphy-key"

# --- Local Node dev server (scripts/dev.js) only ---
# Leave DB_FILE unset (or ":memory:") to run without Turso credentials.
# DB_FILE=".data/mantisbin.db"
# PORT="8787"
# HOST="0.0.0.0"

# Only for embedding the local Node server in an Arena preview. Off by default.
# DEV_PREVIEW="1"

# --- Administration (optional; disabled until configured) -------------------
# Add ADMIN_PASSWORD as a Secret in Cloudflare Workers > your Worker >
# Settings > Variables and Secrets. Use a unique randomly generated password
# (16–256 characters). APP_SECRET above must also be at least 16 characters.
# There is deliberately no default admin password. Do NOT commit a real value.
#   wrangler secret put ADMIN_PASSWORD
# Visit /admin after deployment. Rotating either secret invalidates admin sessions.
